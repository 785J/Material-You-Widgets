<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Boot receiver to re-register dynamic widget listeners -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Calendar widget -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    
    <!-- Digital wellbeing widget (screen time tracking) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name="com.material.you.widgets.WidgetsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.App.Starting"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="com.material.you.widgets.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ══════════════════════════════════════ -->
        <!--              CALENDAR WIDGETS          -->
        <!-- ══════════════════════════════════════ -->

        <receiver
            android:name="com.material.you.widgets.glance.calendar.MediumCalendarWidget$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/medium_calendar_widget_info" />
        </receiver>

        <receiver
            android:name="com.material.you.widgets.glance.calendar.LargeCalendarWidget$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/large_calendar_widget_info" />
        </receiver>

        <!-- ══════════════════════════════════════ -->
        <!--              BATTERY WIDGET            -->
        <!-- ══════════════════════════════════════ -->
        <!--
            NOTE: BatteryWidget registers ACTION_BATTERY_CHANGED, POWER_CONNECTED,
            POWER_DISCONNECTED, BATTERY_LOW, and BATTERY_OKAY **dynamically** in its
            Receiver.onEnabled().  ACTION_BATTERY_CHANGED is a sticky broadcast that
            cannot be declared in the manifest; runtime registration is required.
        -->
        <receiver
            android:name="com.material.you.widgets.glance.battery.BatteryWidget$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <!-- ══════════════════════════════════════ -->
        <!--         DIGITAL WELLBEING WIDGET       -->
        <!-- ══════════════════════════════════════ -->

        <receiver
            android:name="com.material.you.widgets.glance.wellbeing.WatchTimeWidget$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watch_time_widget_info" />
        </receiver>

        <!-- ══════════════════════════════════════ -->
        <!--           SHAPE CLOCK WIDGET           -->
        <!-- ══════════════════════════════════════ -->
        <!--
            ShapeClockWidget: per-minute updates via TIME_TICK dynamically
            registered in Receiver.onEnabled(), matching the original APK's
            ShapeClock registration pattern exactly.
        -->
        <receiver
            android:name="com.material.you.widgets.glance.clock.ShapeClockWidget$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shape_clock_widget_info" />
        </receiver>

        <!-- ══════════════════════════════════════ -->
        <!--         YEAR PROGRESS WIDGET           -->
        <!-- ══════════════════════════════════════ -->

        <receiver
            android:name="com.material.you.widgets.glance.yearprogresss.YearProgressWidget$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/year_progress_widget_info" />
        </receiver>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--  BOOT COMPLETED — re-register dynamic receivers after device boot  -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--
            Dynamic receivers (BATTERY_CHANGED for battery) are unregistered
            when the process dies.  The BootReceiver triggers onEnabled() for
            each active widget type so they re-register on boot.
        -->
        <receiver
            android:name="com.material.you.widgets.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
